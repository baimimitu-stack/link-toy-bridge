# 复制成 .env 再改。.env 含密钥，绝对不要提交到 git（.gitignore 已经挡了）。
# 密钥用 `python tools/gen_secrets.py` 生成，别自己编。

# ── 本机：Intiface Central 的地址（它里面点 Start Server 后默认就是这个）
INTIFACE_URL=ws://127.0.0.1:12345

# ── 本机桥（bridge.py）。只给本机的中继调，不用对外，监听 127.0.0.1 最稳妥
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8791
BRIDGE_TOKEN=换成 gen_secrets 生成的
# 输出上限 0-100。想给对方一个"最大强度"的保险就调低
MAX_STRENGTH=100

# ── 本机掌机面板（mediator.py）。只给本机窗口用；不设钥匙就是本机免鉴权
MEDIATOR_PORT=8800
# 默认只听本机。想让同一局域网的手机也能开面板才改成 0.0.0.0，而且必须同时设 MEDIATOR_TOKEN
# MEDIATOR_HOST=127.0.0.1
MEDIATOR_TOKEN=
BRIDGE_MCP=http://127.0.0.1:8791/mcp

# ── 电脑中继（linkrelay.py）：把电脑接到服务器。可以写多台，逗号隔开
LINK_SERVERS=wss://your-domain.example/link
LINK_RELAY_TOKEN=换成 gen_secrets 生成的 RELAY_TOKEN

# ── 可选：启动脚本找不到时才需要写
# LINK_PY=C:\path\to\python.exe
# LINK_INTIFACE=C:\Users\你\AppData\Roaming\IntifaceCentral\intiface_central.exe
